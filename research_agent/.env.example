# Copy to .env and fill in values. Never commit .env.

# HuggingFace — weights + datasets cached on SSD3
HF_HOME=/mnt/SSD3/yigit/hf_cache
HF_HUB_CACHE=/mnt/SSD3/yigit/hf_cache/hub
TRANSFORMERS_CACHE=/mnt/SSD3/yigit/hf_cache/transformers

# Where we pull model weights for vLLM --model-dir
VLLM_MODEL_DIR=/mnt/SSD3/yigit/models

# OpenAI (for GPT-5 frontier baseline)
OPENAI_API_KEY=

# vLLM serving endpoints (filled when we run serve_vllm_*.sh scripts)
VLLM_GPT_OSS_20B_URL=http://127.0.0.1:8001/v1
VLLM_QWEN25_7B_URL=http://127.0.0.1:8002/v1
VLLM_QWEN25_3B_URL=http://127.0.0.1:8003/v1
VLLM_QWQ_32B_URL=http://127.0.0.1:8004/v1
VLLM_ASEARCHER_7B_URL=http://127.0.0.1:8005/v1
VLLM_ASEARCHER_14B_URL=http://127.0.0.1:8006/v1
VLLM_CONTEXT1_URL=http://127.0.0.1:8007/v1
VLLM_TONGYI_DR_URL=http://127.0.0.1:8008/v1

# Path to the sibling gsw-memory repo we lightweight-import from
GSW_MEMORY_ROOT=/home/yigit/codebase/gsw-memory
